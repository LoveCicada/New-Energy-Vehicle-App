.mine {
  padding: var(--space-3);
}

.login-box {
  background: var(--color-card);
  border-radius: var(--radius-m);
  padding: 48rpx var(--space-4);
  text-align: center;
}

.hint {
  color: var(--color-text-2);
  margin-bottom: 28rpx;
}

.btn {
  background: var(--color-brand);
  color: #fff;
}

.section {
  background: var(--color-card);
  border-radius: var(--radius-m);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-weight: 600;
  margin-bottom: var(--space-2);
}

.row button {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.follow-item,
.fav-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-2) 0;
  border-top: 1rpx solid #f0f0f0;
}

.unlink {
  color: var(--color-brand);
  font-size: 24rpx;
}

.fav-item {
  display: block;
}

.fav-title {
  font-size: 28rpx;
}

.fav-meta {
  margin-top: 6rpx;
  color: var(--color-text-3);
  font-size: 22rpx;
}

.empty-line {
  color: var(--color-text-3);
  font-size: 24rpx;
}
