.feed {
  padding-bottom: 40rpx;
}

.chips {
  width: 100%;
  padding: var(--space-2) var(--space-3) 0;
  box-sizing: border-box;
  white-space: normal;
}

.chip {
  display: inline-block;
  flex-shrink: 0;
  padding: 10rpx var(--space-3);
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text-2);
  font-size: 24rpx;
  border: 1rpx solid var(--color-line);
}

.chip-on {
  background: var(--color-brand);
  color: #fff;
  border-color: var(--color-brand);
}

.chip-hover {
  opacity: 0.7;
}

.empty-clear {
  margin-top: var(--space-3);
  color: var(--color-brand);
  font-size: 28rpx;
}

.card {
  margin: 20rpx var(--space-3) 0;
  background: var(--color-card);
  border-radius: var(--radius-m);
  overflow: hidden;
}

.cover-wrap {
  position: relative;
  height: 340rpx;
  background: var(--color-brand);
}

.cover-fallback {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.cover {
  position: relative;
  width: 100%;
  height: 340rpx;
  display: block;
}

.card-body {
  padding: 20rpx var(--space-3) 28rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text);
}

.price {
  margin-top: 8rpx;
  color: var(--color-brand);
  font-size: 30rpx;
  font-weight: 700;
}

.tagrow { margin-top: 12rpx; }

.mini {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 12rpx;
  background: var(--color-tag-bg);
  color: var(--color-brand);
  font-size: 20rpx;
  border-radius: 6rpx;
}
