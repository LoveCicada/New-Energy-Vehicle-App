.feed {
  padding-bottom: 40rpx;
}

.chips {
  width: 100%;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
  white-space: normal;
}

.chips-sub {
  padding-top: 8rpx;
}

.chip {
  display: inline-block;
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 24rpx;
  border: 1rpx solid #e5e5e5;
}

.chip-on {
  background: #0b6e4f;
  color: #fff;
  border-color: #0b6e4f;
}

.chip-hover {
  opacity: 0.7;
}

.empty-clear {
  margin-top: 24rpx;
  color: #0b6e4f;
  font-size: 28rpx;
}

.card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 320rpx;
  background: #eee;
}

.card-body {
  padding: 20rpx 24rpx 28rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.meta {
  margin-top: 8rpx;
  color: #0b6e4f;
  font-size: 22rpx;
}

.summary {
  margin-top: 12rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
