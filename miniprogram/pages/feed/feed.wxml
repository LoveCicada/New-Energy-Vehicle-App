<wxs src="./feed.wxs" module="utils" />
<view class="feed">
  <view class="chips">
    <view
      wx:for="{{buckets}}"
      wx:key="id"
      class="chip {{bucketId === item.id ? 'chip-on' : ''}}"
      hover-class="chip-hover"
      data-id="{{item.id || 'all'}}"
      catchtap="onBucket"
    >{{item.name}}</view>
  </view>

  <view wx:if="{{subBrands.length}}" class="chips chips-sub">
    <view
      class="chip {{subBrandId === '' ? 'chip-on' : ''}}"
      hover-class="chip-hover"
      data-id="all"
      catchtap="onSubBrand"
    >全部子品牌</view>
    <view
      wx:for="{{subBrands}}"
      wx:key="id"
      class="chip {{subBrandId === item.id ? 'chip-on' : ''}}"
      hover-class="chip-hover"
      data-id="{{item.id}}"
      catchtap="onSubBrand"
    >{{item.name}}</view>
  </view>

  <view class="chips">
    <view
      wx:for="{{tags}}"
      wx:key="*this"
      class="chip {{utils.indexOf(selectedTags, item) >= 0 ? 'chip-on' : ''}}"
      hover-class="chip-hover"
      data-tag="{{item}}"
      catchtap="onTag"
    >{{item}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{empty}}" class="empty">
    <view>暂时还没有动态</view>
    <view class="empty-clear" catchtap="clearFilters">清除筛选</view>
  </view>

  <block wx:for="{{displayList}}" wx:key="id">
    <view wx:if="{{item.type === 'post'}}" class="card" data-id="{{item.id}}" catchtap="goDetail">
      <image wx:if="{{item.item.cover}}" class="cover" src="{{item.item.cover}}" mode="aspectFill" />
      <view class="card-body">
        <view class="title">{{item.item.title}}</view>
        <view class="meta">
          <text>{{item.item.subBrandText || item.item.bucketText}}</text>
          <text wx:if="{{item.item.launchStatusText}}"> · {{item.item.launchStatusText}}</text>
          <text wx:if="{{item.item.priceText}}"> · {{item.item.priceText}}</text>
        </view>
        <view class="summary">{{item.item.summary}}</view>
      </view>
    </view>
    <ad-banner wx:elif="{{item.type === 'ad'}}" unit-id="{{item.unitId}}" />
  </block>
</view>
