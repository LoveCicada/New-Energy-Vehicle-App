.detail {
  padding-bottom: 60rpx;
}

.hero {
  position: relative;
  height: 400rpx;
  background: var(--color-brand);
}

.hero-fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.cover {
  width: 100%;
  height: 400rpx;
  position: relative;
  display: block;
}

.pad {
  padding: 28rpx var(--space-4);
  background: var(--color-card);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.price {
  margin-top: 12rpx;
  color: var(--color-brand);
  font-size: 36rpx;
  font-weight: 700;
}

.specs {
  display: flex;
  margin-top: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  overflow: hidden;
}

.spec {
  flex: 1;
  text-align: center;
  padding: 20rpx 8rpx;
}

.spec + .spec {
  border-left: 1rpx solid var(--color-line);
}

.spec-v {
  font-size: 26rpx;
  font-weight: 600;
}

.spec-k {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-3);
}

.h {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.bullet {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  padding-left: 8rpx;
}

.source {
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-line);
  color: #888;
  font-size: 24rpx;
}

.link {
  color: var(--color-brand);
}

.fav {
  margin-top: var(--space-4);
  background: var(--color-brand);
  color: #fff;
  font-size: 28rpx;
}
