.detail {
  padding-bottom: 60rpx;
}

.cover {
  width: 100%;
  height: 400rpx;
  background: var(--color-line);
}

.pad {
  padding: 28rpx var(--space-4);
  background: var(--color-card);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.meta {
  margin-top: 12rpx;
  color: var(--color-brand);
  font-size: 24rpx;
}

.tags {
  margin-top: var(--space-2);
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  background: var(--color-tag-bg);
  color: var(--color-brand);
  font-size: 22rpx;
  border-radius: 6rpx;
}

.body {
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  white-space: pre-wrap;
}

.source {
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-line);
  color: #888;
  font-size: 24rpx;
}

.link {
  color: var(--color-brand);
}

.fav {
  margin-top: var(--space-4);
  background: var(--color-brand);
  color: #fff;
  font-size: 28rpx;
}
