.detail {
  padding-bottom: 60rpx;
}

.cover {
  width: 100%;
  height: 400rpx;
  background: #eee;
}

.pad {
  padding: 28rpx 32rpx;
  background: #fff;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.meta {
  margin-top: 12rpx;
  color: #0b6e4f;
  font-size: 24rpx;
}

.tags {
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  padding: 4rpx 14rpx;
  background: #eef7f3;
  color: #0b6e4f;
  font-size: 22rpx;
  border-radius: 6rpx;
}

.body {
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  white-space: pre-wrap;
}

.source {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
  color: #888;
  font-size: 24rpx;
}

.link {
  color: #0b6e4f;
}

.fav {
  margin-top: 32rpx;
  background: #0b6e4f;
  color: #fff;
  font-size: 28rpx;
}
